#!/usr/bin/env python3
"""graceinstall: install GraceOS to a disk.

It is archinstall's guided installer (the same menus: disk, user, password, locale and so on)
with GraceOS defaults filled in: the GraceOS package repo and either the Full or the Minimal
package set. archinstall's options still work, for example --config (merged over the GraceOS
defaults), --creds and --silent. --full or --minimal skips the question.

Dual boot (dualboot.py): it first scans the disks read-only. When Windows or another OS is there it
offers to install alongside it in free space, warns about BitLocker, Fast Startup and the clock, and
stops before archinstall erases anything that holds data unless the user types the device name
(unattended: --allow-erase DEVICE, repeatable). --rtc-local keeps the hardware clock in local time
like Windows. --no-gpu-detect skips adding GPU driver packages for the detected graphics.
"""

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

SHARE = Path("/usr/share/graceinstall")
# dualboot.py sits in SHARE on the ISO, next to this script in a checkout
sys.path[:0] = [str(SHARE), str(Path(__file__).resolve().parent)]
import dualboot  # noqa: E402

# Signed with the GraceOS key (docs/decisions/0014-signed-repo.md). The live ISO trusts it (graceos-keyring
# is on the ISO and pacman-init populates every keyring at boot), pacstrap checks with that keyring, and
# graceos-keyring's install script adds the key to the new system's keyring for later updates.
GRACEOS_REPO = {
    "name": "graceos",
    "url": "https://github.com/itsHarshDabas/GraceOS/releases/download/repo-x86_64",
    "sign_check": "Required",
    "sign_option": "TrustedOnly",
}


# archinstall 4.5 appends custom repos to the live pacman.conf, copies that file to the target,
# then appends them to the target again, so each repo shows up twice ("database already
# registered" on every pacman run). Runs in the new system after the install: keep the first
# copy of each [section].
DEDUPE_PACMAN_CONF = (
    "awk '/^\\[.*\\]$/ { skip = ($0 in seen); seen[$0] = 1 } !skip' /etc/pacman.conf"
    " > /etc/pacman.conf.new && mv /etc/pacman.conf.new /etc/pacman.conf"
)


def package_sets(text: str) -> tuple[list[str], list[str]]:
    """(full, minimal) from the packages file: every section, or only those marked [minimal]."""
    full, minimal, in_minimal = [], [], False
    for line in map(str.strip, text.splitlines()):
        if line.startswith("# ---"):
            in_minimal = "[minimal]" in line
        elif line and not line.startswith("#"):
            full.append(line)
            if in_minimal:
                minimal.append(line)
    return full, minimal


def defaults(edition: str, gpus: list[tuple[str, str, str]] | None = None) -> dict:
    full, minimal = package_sets((SHARE / "packages").read_text())
    packages, commands = (full if edition == "full" else minimal), [DEDUPE_PACMAN_CONF]
    if edition == "full" and gpus:
        gpu_packages, notes, gpu_commands = dualboot.gpu_choice(gpus)
        packages = [*packages, *(p for p in gpu_packages if p not in packages)]
        commands += gpu_commands
        for note in notes:
            print(f"Graphics: {note}")
    config = {
        "hostname": "graceos",
        "network_config": {"type": "nm"},
        "packages": packages,
        "timezone": "UTC",
        "mirror_config": {"custom_repositories": [GRACEOS_REPO]},
        "custom_commands": commands,
    }
    if edition == "full":
        config["app_config"] = {"audio_config": {"audio": "pipewire"}, "bluetooth_config": {"enabled": True}}
    return config


def ask_edition(args: list[str]) -> tuple[str, list[str]]:
    for flag in ("--full", "--minimal"):
        if flag in args:
            return flag[2:], [a for a in args if a != flag]
    if "--silent" in args:
        return "full", args
    print("Which GraceOS?\n"
          "  1) Full: the Grace desktop, CandySole and CherryColaLLM (local AI)\n"
          "  2) Minimal: no desktop, close to a bare Arch install, for old or small PCs\n"
          "Either way, Windows app support (Wine) is optional: run `grace-wine install` after installing.")
    return ("minimal" if input("Choose 1 or 2 [1]: ").strip() == "2" else "full"), args


def take_flag(args: list[str], flag: str, with_value: bool = False) -> tuple[list[str], list[str]]:
    """Remove graceinstall's own flags (archinstall rejects unknown ones). Returns (values, rest)."""
    values, rest, i = [], [], 0
    while i < len(args):
        if args[i] == flag:
            if with_value:
                if i + 1 >= len(args):
                    sys.exit(f"graceinstall: {flag} needs a value")
                values.append(args[i + 1])
                i += 1
            else:
                values.append(flag)
        else:
            rest.append(args[i])
        i += 1
    return values, rest


def merged_config(args: list[str], scan: "dualboot.Scan | None" = None,
                  gpus: list[tuple[str, str, str]] | None = None) -> tuple[dict, list[str]]:
    """GraceOS defaults, then the dual-boot choices, then a user --config if given.
    Returns (config, remaining args)."""
    rtc_local, args = take_flag(args, "--rtc-local")
    edition, args = ask_edition(args)
    config = defaults(edition, gpus)
    if scan is not None and "--silent" not in args:
        extra, commands = dualboot.choose(scan)
        config.update(extra)
        config["custom_commands"] += commands
    if rtc_local and dualboot.RTC_LOCAL_COMMAND not in config["custom_commands"]:
        config["custom_commands"].append(dualboot.RTC_LOCAL_COMMAND)
    if "--config" in args:
        i = args.index("--config")
        if i + 1 >= len(args):
            sys.exit("graceinstall: --config needs a file")
        user = json.loads(Path(args[i + 1]).read_text())
        args = args[:i] + args[i + 2:]
        # The GraceOS repo stays even when the user brings their own mirror settings.
        mirrors = user.pop("mirror_config", {})
        repos = [r for r in mirrors.get("custom_repositories", []) if r.get("name") != "graceos"]
        commands = user.pop("custom_commands", [])
        config.update(user)
        config["custom_commands"] = [*config["custom_commands"], *commands]
        config["mirror_config"] = {**mirrors, "custom_repositories": [GRACEOS_REPO, *repos]}
    return config, args


def main() -> int:
    allowed, args = take_flag(sys.argv[1:], "--allow-erase", with_value=True)
    no_gpu, args = take_flag(args, "--no-gpu-detect")
    interactive = "--silent" not in args
    try:
        scan = dualboot.scan()
    except (OSError, ValueError, subprocess.CalledProcessError) as err:
        sys.exit(f"graceinstall: couldn't scan the disks ({err}); stopping so nothing gets erased by mistake.")
    gpus = [] if no_gpu else dualboot.pci_display_devices()
    config, args = merged_config(args, scan, gpus)
    fd, path = tempfile.mkstemp(prefix="graceinstall-", suffix=".json")
    with open(fd, "w") as f:
        json.dump(config, f)
    sys.argv = ["archinstall", "--config", path, "--skip-version-check", *args]

    dualboot.install_hooks(scan, {os.path.realpath(a) for a in allowed} | set(allowed), interactive)
    from archinstall.main import main as archinstall_main

    return archinstall_main()


if __name__ == "__main__":
    sys.exit(main())
