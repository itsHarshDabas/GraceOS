#!/usr/bin/env python3
"""graceinstall: install GraceOS to a disk.

It is archinstall's guided installer (the same menus: disk, user, password, locale and so on)
with GraceOS defaults filled in: the GraceOS package repo and either the Full or the Minimal
package set. archinstall's options still work, for example --config (merged over the GraceOS
defaults), --creds and --silent. --full or --minimal skips the question.
"""

import json
import sys
import tempfile
from pathlib import Path

SHARE = Path("/usr/share/graceinstall")

# shortcut: unsigned (Optional TrustAll), packages come over HTTPS from GitHub Releases;
# sign the repo with a key kept in a CI secret before a public release.
GRACEOS_REPO = {
    "name": "graceos",
    "url": "https://github.com/itsHarshDabas/GraceOS/releases/download/repo-x86_64",
    "sign_check": "Optional",
    "sign_option": "TrustAll",
}


# archinstall 4.5 appends custom repos to the live pacman.conf, copies that file to the target,
# then appends them to the target again, so each repo shows up twice ("database already
# registered" on every pacman run). Runs in the new system after the install: keep the first
# copy of each [section].
DEDUPE_PACMAN_CONF = (
    "awk '/^\\[.*\\]$/ { skip = ($0 in seen); seen[$0] = 1 } !skip' /etc/pacman.conf"
    " > /etc/pacman.conf.new && mv /etc/pacman.conf.new /etc/pacman.conf"
)


def package_sets(text: str) -> tuple[list[str], list[str]]:
    """(full, minimal) from the packages file: every section, or only those marked [minimal]."""
    full, minimal, in_minimal = [], [], False
    for line in map(str.strip, text.splitlines()):
        if line.startswith("# ---"):
            in_minimal = "[minimal]" in line
        elif line and not line.startswith("#"):
            full.append(line)
            if in_minimal:
                minimal.append(line)
    return full, minimal


def defaults(edition: str) -> dict:
    full, minimal = package_sets((SHARE / "packages").read_text())
    config = {
        "hostname": "graceos",
        "network_config": {"type": "nm"},
        "packages": full if edition == "full" else minimal,
        "timezone": "UTC",
        "mirror_config": {"custom_repositories": [GRACEOS_REPO]},
        "custom_commands": [DEDUPE_PACMAN_CONF],
    }
    if edition == "full":
        config["app_config"] = {"audio_config": {"audio": "pipewire"}, "bluetooth_config": {"enabled": True}}
    return config


def ask_edition(args: list[str]) -> tuple[str, list[str]]:
    for flag in ("--full", "--minimal"):
        if flag in args:
            return flag[2:], [a for a in args if a != flag]
    if "--silent" in args:
        return "full", args
    print("Which GraceOS?\n"
          "  1) Full: the Grace desktop, CandySole, CherryCola (local AI) and Wine\n"
          "  2) Minimal: no desktop, close to a bare Arch install, for old or small PCs")
    return ("minimal" if input("Choose 1 or 2 [1]: ").strip() == "2" else "full"), args


def merged_config(args: list[str]) -> tuple[dict, list[str]]:
    """GraceOS defaults, overridden by a user --config if given. Returns (config, remaining args)."""
    edition, args = ask_edition(args)
    config = defaults(edition)
    if "--config" in args:
        i = args.index("--config")
        if i + 1 >= len(args):
            sys.exit("graceinstall: --config needs a file")
        user = json.loads(Path(args[i + 1]).read_text())
        args = args[:i] + args[i + 2:]
        # The GraceOS repo stays even when the user brings their own mirror settings.
        mirrors = user.pop("mirror_config", {})
        repos = [r for r in mirrors.get("custom_repositories", []) if r.get("name") != "graceos"]
        commands = user.pop("custom_commands", [])
        config.update(user)
        config["custom_commands"] = [DEDUPE_PACMAN_CONF, *commands]
        config["mirror_config"] = {**mirrors, "custom_repositories": [GRACEOS_REPO, *repos]}
    return config, args


def main() -> int:
    config, args = merged_config(sys.argv[1:])
    fd, path = tempfile.mkstemp(prefix="graceinstall-", suffix=".json")
    with open(fd, "w") as f:
        json.dump(config, f)
    sys.argv = ["archinstall", "--config", path, "--skip-version-check", *args]

    from archinstall.main import main as archinstall_main

    return archinstall_main()


if __name__ == "__main__":
    sys.exit(main())
