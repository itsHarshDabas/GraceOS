{
  "mirror_config": {
    "custom_repositories": [
      {
        "name": "graceos",
        "url": "https://github.com/itsHarshDabas/GraceOS/releases/download/repo-x86_64",
        "sign_check": "Optional",
        "sign_option": "TrustAll"
      }
    ]
  },
  "network_config": {
    "type": "nm"
  },
  "app_config": {
    "audio_config": {
      "audio": "pipewire"
    },
    "bluetooth_config": {
      "enabled": true
    }
  },
  "profile_config": {
    "profile": {
      "main": "Desktop",
      "details": [
        "Grace Candyland"
      ],
      "path": "grace_candyland.py"
    },
    "greeter": "sddm",
    "gfx_driver": "All open-source"
  },
  "custom_commands": [
    "awk '/^\\[.*\\]$/ { skip = ($0 in seen); seen[$0] = 1 } !skip' /etc/pacman.conf > /etc/pacman.conf.new && mv /etc/pacman.conf.new /etc/pacman.conf"
  ]
}
