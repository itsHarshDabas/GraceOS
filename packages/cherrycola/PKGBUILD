# Maintainer: GraceOS <https://github.com/itsHarshDabas/GraceOS>
# Builds the CherrySoda commit pinned in iso/cherrysoda.ref (build-packages.sh passes it in).
pkgname=cherrycola
pkgver=r0
pkgrel=1
pkgdesc="CherryCola: local model inference for GraceOS (Ollama by default, LM Studio supported)"
arch=(any)
url=https://github.com/itsHarshDabas/CherrySoda
license=(LicenseRef-unspecified)
depends=(python)
optdepends=(
  'ollama: run models on the CPU (or ollama-cuda, ollama-rocm, ollama-vulkan for a GPU)'
  'python-gobject: the CherryCola chat app'
  'libadwaita: the CherryCola chat app'
)
makedepends=(git)
source=("git+$url.git#commit=${CHERRYSODA_COMMIT:?set CHERRYSODA_COMMIT}")
sha256sums=(SKIP)

pkgver() {
  cd CherrySoda
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd CherrySoda
  install -d "$pkgdir/usr/lib/cherrycola"
  cp -r cherrycola "$pkgdir/usr/lib/cherrycola/"
  find "$pkgdir/usr/lib/cherrycola" -name __pycache__ -prune -exec rm -rf {} +
  install -Dm755 bin/cherrycola "$pkgdir/usr/bin/cherrycola"
  install -Dm755 bin/cherrycola-chat "$pkgdir/usr/bin/cherrycola-chat"
  install -Dm644 data/org.graceos.CherryCola.desktop "$pkgdir/usr/share/applications/org.graceos.CherryCola.desktop"
  install -Dm644 data/org.graceos.CherryCola.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.graceos.CherryCola.svg"
}
