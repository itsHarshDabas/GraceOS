[Desktop Entry]
Name=ToffeeTwirl IDE
Comment=Code editing, with GraceOS's local AI
GenericName=Text Editor
Exec=/usr/bin/twirl %F
Icon=toffeetwirl
Type=Application
StartupNotify=false
StartupWMClass=twirl
Categories=TextEditor;Development;IDE;
MimeType=text/plain;inode/directory;application/x-twirl-workspace;
Actions=new-empty-window;
Keywords=toffeetwirl;twirl;vscode;vscodium;code;editor;ide;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/usr/bin/twirl --new-window %F
Icon=toffeetwirl
