#!/usr/bin/env python3
"""Launcher: installed as /usr/bin/cherrycola, package at /usr/lib/cherrycola."""

import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_CANDIDATES = [
    # Installed: /usr/bin/cherrycola -> /usr/lib/cherrycola.
    os.path.join(_HERE, "..", "lib", "cherrycola"),
    # Repo checkout: services/cherrycola/bin/cherrycola -> services/cherrycola.
    os.path.join(_HERE, ".."),
]
for _cand in _CANDIDATES:
    if os.path.isdir(os.path.join(_cand, "cherrycola")):
        sys.path.insert(0, os.path.normpath(_cand))
        break

from cherrycola.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
